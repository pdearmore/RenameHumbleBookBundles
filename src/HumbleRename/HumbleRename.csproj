<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>HumbleRenamer</AssemblyName>
    <RootNamespace>HumbleRename</RootNamespace>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Product>HumbleRenamer</Product>
    <Description>Renames Humble Bundle comic and ebook files to proper titles.</Description>
    <Version>1.0.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HumbleRename.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\words.txt.gz" LogicalName="HumbleRename.Data.words.txt.gz" />
    <EmbeddedResource Include="Data\lexicon.txt" LogicalName="HumbleRename.Data.lexicon.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.15" />
    <PackageReference Include="SharpCompress" Version="0.50.3" />
  </ItemGroup>

</Project>
