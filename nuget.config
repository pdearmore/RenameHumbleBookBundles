<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Pinned to nuget.org only. Machine-level configs on some dev boxes register
    authenticated feeds (e.g. nuget.telerik.com) that return 401 and abort the
    whole restore, so <clear/> keeps this repo buildable anywhere.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
